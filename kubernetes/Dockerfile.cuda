# Dockerfile for torchtitan on OCI OKE with NVIDIA CUDA GPUs (e.g. BM.GPU4.8).
#
# Build:
#   docker build -f kubernetes/Dockerfile.cuda \
#     -t <registry>/torchtitan:cuda-<tag> .
#
# Base image guidance comes from internal NVIDIA image notes shared by the team.

ARG BASE_IMAGE=nvcr.io/nvidia/cuda-dl-base:26.01-cuda13.1-inference-devel-ubuntu24.04
ARG NCCL_PKG_VERSION=

FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG NCCL_PKG_VERSION

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:${PATH}

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    python3-dev \
    python3-venv \
    infiniband-diags \
    openssh-server \
    openmpi-bin \
    libopenmpi-dev \
    kmod \
    wget \
    ca-certificates \
    iproute2 \
    net-tools \
    iputils-ping \
    curl \
    tcpdump \
    ethtool \
    lsof \
    pciutils \
    numactl \
    iperf3 \
    git \
    && if [ -n "${NCCL_PKG_VERSION}" ]; then \
        CUDA_ARCH=$([ "$(dpkg --print-architecture)" = "amd64" ] && echo "x86_64" || echo "sbsa") \
        && wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/${CUDA_ARCH}/cuda-keyring_1.1-1_all.deb \
        && dpkg -i cuda-keyring_1.1-1_all.deb \
        && rm cuda-keyring_1.1-1_all.deb \
        && apt-get update \
        && apt-get install -y --no-install-recommends \
            libnccl2=${NCCL_PKG_VERSION} \
            libnccl-dev=${NCCL_PKG_VERSION}; \
    fi \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i 's/[ #]\(.*StrictHostKeyChecking \).*/ \1no/g' /etc/ssh/ssh_config && \
    echo "    UserKnownHostsFile /dev/null" >> /etc/ssh/ssh_config && \
    sed -i 's/#\(StrictModes \).*/\1no/g' /etc/ssh/sshd_config && \
    mkdir -p /var/run/sshd

RUN curl -fsSL -o /usr/sbin/ibdev2netdev \
    https://raw.githubusercontent.com/Mellanox/container_scripts/refs/heads/master/ibdev2netdev \
    && chmod +x /usr/sbin/ibdev2netdev

WORKDIR /workspace/torchtitan

RUN python3 -m venv "${VIRTUAL_ENV}"

# Install Python dependencies before copying source to maximise layer caching.
COPY kubernetes/image-constraints.txt /opt/torchtitan-constraints.txt
ENV PIP_CONSTRAINT=/opt/torchtitan-constraints.txt
COPY requirements.txt .
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install --index-url https://download.pytorch.org/whl/cu130 \
        --no-deps torch==2.14.1+cu130 \
    && python -m pip install "torch==2.14.1+cu130" -r requirements.txt

COPY . .
# NVIDIA's ARM64 cuSPARSELt 0.8.1 wheel has an internal "sbsa" platform
# tag. Verify the shared library loads and allow only that exact pip message.
RUN python -m pip install -e . \
    && { python -m pip check > /tmp/pip-check.txt || { \
        cat /tmp/pip-check.txt && test "$(uname -m)" = aarch64 \
        && test "$(cat /tmp/pip-check.txt)" = 'nvidia-cusparselt-cu13 0.8.1 is not supported on this platform' \
        && python -c "import ctypes, importlib.metadata as m; d=m.distribution('nvidia-cusparselt-cu13'); ctypes.CDLL(str(next(d.locate_file(f) for f in d.files if f.name == 'libcusparseLt.so.0')))"; \
    }; } \
    && python -c "import torch; assert torch.version.cuda and not torch.version.hip" \
    && command -v mpirun && command -v ssh && command -v sshd \
    && command -v ssh-keyscan && command -v torchrun

ENV PIP_CONSTRAINT=""
CMD ["bash"]
